{
    "name": "ahmedibrahimyassindev/signit-php-sdk",
    "description": "Framework-independent PHP SDK for the Signit e-signature API with Laravel integration",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=7.1.0",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "Signit\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "homepage": "https://github.com/ahmedibrahimyassindev/signit-php-sdk",
    "authors": [
        {
            "name": "Ahmed Ibrahim Yassin",
            "role": "Developer"
        }
    ],
    "keywords": [
        "signit",
        "e-signature",
        "electronic-signature",
        "signature",
        "sdk",
        "laravel",
        "php"
    ],
    "suggest": {
        "illuminate/support": "Install Laravel to use the auto-discovered service provider and configuration."
    },
    "extra": {
        "laravel": {
            "providers": [
                "Signit\\Laravel\\SignitServiceProvider"
            ]
        }
    },
    "support": {
        "source": "https://github.com/ahmedibrahimyassindev/signit-php-sdk"
    }
}
